---
import AvailabilityBadge from '@/components/shared/availability-badge'
import HeroCta from '@/components/home/hero/hero-cta'
import IdCard from '@/components/ui/id-card'
---

<section class='lg:relative'>
  <div class='border-b pb-8 max-sm:pt-20 sm:py-16 lg:pt-32 lg:pb-24'>
    <div class='px-4 sm:px-6 lg:px-10.5'>
      <div class='space-y-6 lg:max-w-lg'>
        <AvailabilityBadge className='h-6.5 gap-1 rounded-full' />
        <h1 class='mb-2 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[64px] lg:font-bold'>Hello, I am Delcio</h1>
        <p class='text-muted-foreground text-xl font-medium sm:text-2xl lg:text-3xl'>Backend Developer</p>
        <p class='mb-8 max-w-2xl text-base'>
          Backend developer based in Luanda, Angola. I turn complex requirements into robust, well-structured
          systems — APIs, databases, Linux servers, and automation that make products run smoother.
        </p>
        <HeroCta />
      </div>
    </div>
  </div>

  <!-- client:only — WebGL/Canvas can't SSR -->
  <IdCard
    client:only='react'
    frontImage='/images/profile/profile-desk.png'
    className='mx-auto mt-8 aspect-4/5 w-full max-w-80 lg:absolute lg:-top-31 lg:right-0 lg:left-0 lg:z-10 lg:mt-0 lg:aspect-auto lg:h-192 lg:max-w-none'
  />
</section>
