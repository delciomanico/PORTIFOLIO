---
import { buttonVariants } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'

const socials = [
  { label: 'GitHub', src: '/images/footer/github-logo.webp', href: 'https://github.com/delciomanico' },
  { label: 'Email', src: '/images/footer/gmail.webp', href: 'mailto:monarcadev.full@gmail.com' },
  { label: 'LinkedIn', src: '/images/footer/linkedin.webp', href: 'https://www.linkedin.com/in/monarcadev' }
]

const year = new Date().getFullYear()
---

<footer class='lg:px-10.5'>
  <div class='mx-auto max-w-4xl space-y-12 pb-12 lg:border-x xl:max-w-245'>
    <div class='flex items-center gap-3'>
      <Separator className='flex-1' />
      <div class='flex items-center gap-3'>
        {
          socials.map(social => (
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
              aria-label={social.label}
              class={buttonVariants({ variant: 'outline', size: 'icon', className: 'hover:bg-muted/5 min-w-10 rounded-md' })}
            >
              <img src={social.src} alt={social.label} width={16} height={16} />
            </a>
          ))
        }
      </div>
      <Separator className='flex-1' />
    </div>

    <div class='space-y-1 text-center'>
      <p class='text-foreground text-5xl [font-family:var(--font-handwritten)]'>Delcio</p>
      <p class='text-xs'>@delciomanico {year}</p>
    </div>
  </div>
</footer>
